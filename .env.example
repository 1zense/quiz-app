# Этот файл — только пример для локального запуска БЕЗ Docker.
# При запуске через docker-compose переменные уже прописаны в docker-compose.yml,
# НЕ копируй этот файл в .env — иначе DB_HOST=localhost перебьёт значение "db".

DB_NAME=quizdb
DB_USER=quizuser
DB_PASSWORD=quizpass
DB_HOST=localhost
DB_PORT=5432
